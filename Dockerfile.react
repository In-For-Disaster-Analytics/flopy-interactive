FROM node:22-bookworm-slim AS frontend-build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY index.html vite.config.js ./
COPY src ./src

RUN npm run build

FROM mambaorg/micromamba:1.5.10-jammy

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    FLOPY_DATA_DIR=/data/ckan_data \
    FLOPY_OUTPUT_WEL=/data/output/barton_springs_updated.wel

WORKDIR /app

COPY --chown=$MAMBA_USER:$MAMBA_USER environment.react.yml /tmp/environment.react.yml
RUN micromamba env create -f /tmp/environment.react.yml && \
    micromamba clean --all --yes

COPY --chown=$MAMBA_USER:$MAMBA_USER flopy_interactive ./flopy_interactive
COPY --chown=$MAMBA_USER:$MAMBA_USER flopy_wel_map.py ./flopy_wel_map.py
COPY --chown=$MAMBA_USER:$MAMBA_USER README.md ./README.md
COPY --from=frontend-build --chown=$MAMBA_USER:$MAMBA_USER /app/dist ./dist

EXPOSE 5050

CMD ["micromamba", "run", "-n", "flopy-interactive-react", "gunicorn", "--bind", "0.0.0.0:5050", "--timeout", "600", "flopy_interactive.api:app"]
